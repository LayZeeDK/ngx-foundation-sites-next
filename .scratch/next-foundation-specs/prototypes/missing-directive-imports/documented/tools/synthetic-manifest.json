{
  "version": 1,
  "package": "synthetic",
  "note": "Selectors no class implements, so both checks report every element each one matches: a differential test of template reading and selector matching over the whole workspace. Neither check can find these classes, so nothing is ever in scope.",
  "directives": [
    { "name": "S01", "entryPoint": "synthetic/none", "selector": "[title]" },
    { "name": "S02", "entryPoint": "synthetic/none", "selector": "#main" },
    { "name": "S03", "entryPoint": "synthetic/none", "selector": "button[type=button]" },
    { "name": "S04", "entryPoint": "synthetic/none", "selector": "input[type=checkbox], input[type=email]" },
    { "name": "S05", "entryPoint": "synthetic/none", "selector": "a[href]" },
    { "name": "S06", "entryPoint": "synthetic/none", "selector": "form" },
    { "name": "S07", "entryPoint": "synthetic/none", "selector": "label[for]" },
    { "name": "S08", "entryPoint": "synthetic/none", "selector": ".menu" },
    { "name": "S09", "entryPoint": "synthetic/none", "selector": "header.grid-x, form.grid-x" },
    { "name": "S10", "entryPoint": "synthetic/none", "selector": "[click]" },
    { "name": "S11", "entryPoint": "synthetic/none", "selector": "[keydown.enter]" },
    { "name": "S12", "entryPoint": "synthetic/none", "selector": "[resize]" },
    { "name": "S13", "entryPoint": "synthetic/none", "selector": "[name]:not([type=email])" },
    { "name": "S14", "entryPoint": "synthetic/none", "selector": "use[href]" },
    { "name": "S15", "entryPoint": "synthetic/none", "selector": "ng-template" },
    { "name": "S16", "entryPoint": "synthetic/none", "selector": "ng-container" },
    { "name": "S17", "entryPoint": "synthetic/none", "selector": "[ngTemplateOutlet]" },
    { "name": "S18", "entryPoint": "synthetic/none", "selector": "[ngIf]" },
    { "name": "S19", "entryPoint": "synthetic/none", "selector": "[ngIfElse]" },
    { "name": "S20", "entryPoint": "synthetic/none", "selector": "[animate.enter]" },
    { "name": "S21", "entryPoint": "synthetic/none", "selector": "[animate.leave]" },
    { "name": "S22", "entryPoint": "synthetic/none", "selector": "span[nfsTone=muted]" },
    { "name": "S23", "entryPoint": "synthetic/none", "selector": "[value]" },
    { "name": "S24", "entryPoint": "synthetic/none", "selector": "[valueChange]" },
    { "name": "S25", "entryPoint": "synthetic/none", "selector": "[focus]" },
    { "name": "S26", "entryPoint": "synthetic/none", "selector": "[aria-label], [active], [width]" },
    { "name": "S27", "entryPoint": "synthetic/none", "selector": "[data-nfs-callout]" },
    { "name": "S28", "entryPoint": "synthetic/none", "selector": "[i18n], [i18n-title]" },
    { "name": "S29", "entryPoint": "synthetic/none", "selector": "ng-content, [select], style" },
    { "name": "S30", "entryPoint": "synthetic/none", "selector": "[title]:not(a)" },
    { "name": "S31", "entryPoint": "synthetic/none", "selector": "svg" },
    { "name": "S32", "entryPoint": "synthetic/none", "selector": "button" },
    { "name": "S33", "entryPoint": "synthetic/none", "selector": "[ngNonBindable]" },
    { "name": "S34", "entryPoint": "synthetic/none", "selector": "[item], [anchor], [other], [flag]" },
    { "name": "S35", "entryPoint": "synthetic/none", "selector": "app-card, app-gen-000" },
    { "name": "S36", "entryPoint": "synthetic/none", "selector": ":not(div):not(span)" }
  ],
  "arrays": []
}
