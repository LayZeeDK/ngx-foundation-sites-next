{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "demo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": ["localhost"]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": false
            },
            "m-none": {
              "fileReplacements": [
                {
                  "replace": "src/nfs/import-check/index.ts",
                  "with": "src/nfs/import-check/index.none.ts"
                }
              ]
            },
            "m-registry": {
              "fileReplacements": [
                {
                  "replace": "src/nfs/import-check/strategy.ts",
                  "with": "src/nfs/import-check/strategy.registry.ts"
                }
              ]
            },
            "m-debug": {
              "fileReplacements": [
                {
                  "replace": "src/nfs/import-check/strategy.ts",
                  "with": "src/nfs/import-check/strategy.debug.ts"
                }
              ]
            },
            "m-class": {
              "fileReplacements": [
                {
                  "replace": "src/nfs/import-check/strategy.ts",
                  "with": "src/nfs/import-check/strategy.class.ts"
                }
              ]
            },
            "m-hybrid": {
              "fileReplacements": [
                {
                  "replace": "src/nfs/import-check/strategy.ts",
                  "with": "src/nfs/import-check/strategy.hybrid.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 5470
          },
          "configurations": {
            "production": {
              "buildTarget": "demo:build:production"
            },
            "development": {
              "buildTarget": "demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
