{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "outputPath": "dist/aria-prod",
              "outputHashing": "none"
            },
            "development": {
              "outputPath": "dist/aria-dev",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "production-ngp": {
              "outputPath": "dist/ngp-prod",
              "outputHashing": "none",
              "fileReplacements": [
                {
                  "replace": "src/lib/index.ts",
                  "with": "src/lib/index.ngp.ts"
                }
              ]
            },
            "development-ngp": {
              "outputPath": "dist/ngp-dev",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/lib/index.ts",
                  "with": "src/lib/index.ngp.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 5495
          },
          "configurations": {
            "aria": {
              "buildTarget": "app:build:development"
            },
            "ngp": {
              "buildTarget": "app:build:development-ngp"
            }
          },
          "defaultConfiguration": "aria"
        }
      }
    }
  }
}
