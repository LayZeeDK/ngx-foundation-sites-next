{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ui/src",
  "prefix": "nfs",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/ui/ng-package.json",
        "tsConfig": "packages/ui/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ui/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "exclude": [
          "**/leak-demo/**",
          "**/*.node.spec.ts",
          "**/test-setup-node.ts"
        ]
      },
      "configurations": {
        "leak-demo": {
          "include": [
            "**/leak-demo/*.spec.ts"
          ],
          "exclude": []
        },
        "single-worker": {
          "runnerConfig": "packages/ui/vitest.single-worker.mts"
        }
      }
    },
    "test-node": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "command": "vitest run -c packages/ui/vitest.node.config.mts"
      }
    }
  }
}
