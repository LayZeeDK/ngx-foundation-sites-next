{
  "name": "fixture",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "nfs",
  "sourceRoot": "apps/fixture/src",
  "tags": [],
  "i18n": {
    "sourceLocale": "en-US",
    "locales": {
      "da": {
        "translation": "apps/fixture/src/locale/messages.da.json"
      }
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/fixture-production",
        "browser": "apps/fixture/src/main.ts",
        "server": "apps/fixture/src/main.server.ts",
        "tsConfig": "apps/fixture/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/fixture/public"
          }
        ],
        "styles": [
          "apps/fixture/src/lib/scss/global.scss",
          "apps/fixture/src/styles.scss",
          {
            "input": "apps/fixture/src/lib/scss/button.scss",
            "bundleName": "nfs-button",
            "inject": false
          },
          {
            "input": "apps/fixture/src/lib/scss/callout.scss",
            "bundleName": "nfs-callout",
            "inject": false
          },
          {
            "input": "apps/fixture/src/lib/scss/menu.scss",
            "bundleName": "nfs-menu",
            "inject": false
          },
          {
            "input": "apps/fixture/src/lib/scss/dropdown-menu.scss",
            "bundleName": "nfs-dropdown-menu",
            "inject": false
          }
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "apps/fixture/src/foundation-settings"
          ],
          "sass": {
            "silenceDeprecations": [
              "import",
              "global-builtin",
              "color-functions",
              "slash-div",
              "if-function"
            ]
          }
        },
        "outputMode": "server",
        "ssr": {
          "entry": "apps/fixture/src/server.ts"
        },
        "security": {
          "allowedHosts": []
        }
      },
      "configurations": {
        "production": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-production"
        },
        "unlayered": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-unlayered",
          "stylePreprocessorOptions": {
            "includePaths": [
              "apps/fixture/src/foundation-settings-unlayered",
              "apps/fixture/src/foundation-settings"
            ],
            "sass": {
              "silenceDeprecations": [
                "import",
                "global-builtin",
                "color-functions",
                "slash-div",
                "if-function"
              ]
            }
          }
        },
        "cachebust": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-cachebust",
          "stylePreprocessorOptions": {
            "includePaths": [
              "apps/fixture/src/foundation-settings-cachebust",
              "apps/fixture/src/foundation-settings"
            ],
            "sass": {
              "silenceDeprecations": [
                "import",
                "global-builtin",
                "color-functions",
                "slash-div",
                "if-function"
              ]
            }
          }
        },
        "preload": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-preload",
          "fileReplacements": [
            {
              "replace": "apps/fixture/src/lib/switches.ts",
              "with": "apps/fixture/src/lib/switches.preload.ts"
            }
          ],
          "index": "apps/fixture/src/index.preload.html"
        },
        "single": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-single",
          "fileReplacements": [
            {
              "replace": "apps/fixture/src/lib/switches.ts",
              "with": "apps/fixture/src/lib/switches.single.ts"
            }
          ],
          "styles": [
            "apps/fixture/src/lib/scss/global.scss",
            "apps/fixture/src/styles.scss",
            {
              "input": "apps/fixture/src/lib/scss/all.scss",
              "bundleName": "nfs-families",
              "inject": false
            }
          ]
        },
        "subpath": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-subpath",
          "baseHref": "/sub/"
        },
        "cdn": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-cdn",
          "deployUrl": "http://127.0.0.1:4696/cdn/"
        },
        "i18n": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-i18n",
          "localize": true
        },
        "noskip": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-noskip",
          "fileReplacements": [
            {
              "replace": "apps/fixture/src/lib/switches.ts",
              "with": "apps/fixture/src/lib/switches.noskip.ts"
            }
          ]
        }
      }
    },
    "build-plugin": {
      "executor": "@nx/angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/fixture-plugin",
        "browser": "apps/fixture/src/main.ts",
        "server": "apps/fixture/src/main.server.ts",
        "tsConfig": "apps/fixture/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/fixture/public"
          }
        ],
        "styles": [
          "apps/fixture/src/lib/scss/global.scss",
          "apps/fixture/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "apps/fixture/src/foundation-settings"
          ],
          "sass": {
            "silenceDeprecations": [
              "import",
              "global-builtin",
              "color-functions",
              "slash-div",
              "if-function"
            ]
          }
        },
        "outputMode": "server",
        "ssr": {
          "entry": "apps/fixture/src/server.ts"
        },
        "security": {
          "allowedHosts": []
        },
        "fileReplacements": [
          {
            "replace": "apps/fixture/src/lib/switches.ts",
            "with": "apps/fixture/src/lib/switches.plugin.ts"
          },
          {
            "replace": "apps/fixture/src/lib/plugin-loaders.ts",
            "with": "apps/fixture/src/lib/plugin-loaders.plugin.ts"
          }
        ],
        "plugins": [
          {
            "path": "tools/nfs-esbuild-plugin.mjs",
            "options": {
              "includePaths": [
                "apps/fixture/src/foundation-settings"
              ]
            }
          }
        ],
        "budgets": [],
        "outputHashing": "all"
      }
    }
  }
}
