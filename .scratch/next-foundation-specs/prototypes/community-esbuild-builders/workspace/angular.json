{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "nfs-proto-193": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-esbuild:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/nfs-lib/scss/global.scss",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "plugins": [
              {
                "path": "node_modules/nfs-lib/esbuild/nfs-family-css.mjs",
                "options": {
                  "includePaths": [
                    "src/foundation-settings"
                  ]
                }
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/foundation-settings"
              ],
              "sass": {
                "silenceDeprecations": [
                  "import",
                  "global-builtin",
                  "color-functions",
                  "slash-div",
                  "if-function"
                ]
              }
            }
          },
          "configurations": {
            "production": {
              "budgets": [],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-esbuild:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "nfs-proto-193:build:production"
            },
            "development": {
              "buildTarget": "nfs-proto-193:build:development"
            },
            "development-exclude": {
              "buildTarget": "nfs-proto-193:build:development",
              "prebundle": {
                "exclude": [
                  "nfs-lib"
                ]
              }
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "nfs-lib": {
      "projectType": "library",
      "root": "projects/nfs-lib",
      "sourceRoot": "projects/nfs-lib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/nfs-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/nfs-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/nfs-lib/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
