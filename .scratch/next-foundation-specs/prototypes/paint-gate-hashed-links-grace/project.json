{
  "name": "fixture",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "nfs",
  "sourceRoot": "apps/fixture/src",
  "tags": [],
  "i18n": {
    "sourceLocale": "en-US",
    "locales": {
      "da": {
        "translation": "apps/fixture/src/locale/messages.da.json"
      }
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/fixture-production",
        "browser": "apps/fixture/src/main.ts",
        "server": "apps/fixture/src/main.server.ts",
        "tsConfig": "apps/fixture/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/fixture/public"
          }
        ],
        "styles": [
          "apps/fixture/src/lib/scss/global.scss",
          "apps/fixture/src/styles.scss",
          {
            "input": "apps/fixture/src/lib/scss/button.scss",
            "bundleName": "nfs-button",
            "inject": false
          },
          {
            "input": "apps/fixture/src/lib/scss/callout.scss",
            "bundleName": "nfs-callout",
            "inject": false
          },
          {
            "input": "apps/fixture/src/lib/scss/menu.scss",
            "bundleName": "nfs-menu",
            "inject": false
          },
          {
            "input": "apps/fixture/src/lib/scss/dropdown-menu.scss",
            "bundleName": "nfs-dropdown-menu",
            "inject": false
          }
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "apps/fixture/src/foundation-settings"
          ],
          "sass": {
            "silenceDeprecations": [
              "import",
              "global-builtin",
              "color-functions",
              "slash-div",
              "if-function"
            ]
          }
        },
        "outputMode": "server",
        "ssr": {
          "entry": "apps/fixture/src/server.ts"
        },
        "security": {
          "allowedHosts": []
        }
      },
      "configurations": {
        "production": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-production"
        }
      }
    },
    "build-plugin": {
      "executor": "@nx/angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/fixture-plugin",
        "browser": "apps/fixture/src/main.ts",
        "server": "apps/fixture/src/main.server.ts",
        "tsConfig": "apps/fixture/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/fixture/public"
          }
        ],
        "styles": [
          "apps/fixture/src/lib/scss/global.scss",
          "apps/fixture/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "apps/fixture/src/foundation-settings"
          ],
          "sass": {
            "silenceDeprecations": [
              "import",
              "global-builtin",
              "color-functions",
              "slash-div",
              "if-function"
            ]
          }
        },
        "outputMode": "server",
        "ssr": {
          "entry": "apps/fixture/src/server.ts"
        },
        "security": {
          "allowedHosts": []
        },
        "budgets": [],
        "outputHashing": "all",
        "fileReplacements": [
          {
            "replace": "apps/fixture/src/lib/switches.ts",
            "with": "apps/fixture/src/lib/switches.plugin.ts"
          },
          {
            "replace": "apps/fixture/src/lib/plugin-loaders.ts",
            "with": "apps/fixture/src/lib/plugin-loaders.plugin.ts"
          },
          {
            "replace": "apps/fixture/src/lib/css/button.ts",
            "with": "apps/fixture/src/lib/css/button.plugin.ts"
          },
          {
            "replace": "apps/fixture/src/lib/css/callout.ts",
            "with": "apps/fixture/src/lib/css/callout.plugin.ts"
          },
          {
            "replace": "apps/fixture/src/lib/css/menu.ts",
            "with": "apps/fixture/src/lib/css/menu.plugin.ts"
          },
          {
            "replace": "apps/fixture/src/lib/css/dropdown-menu.ts",
            "with": "apps/fixture/src/lib/css/dropdown-menu.plugin.ts"
          }
        ],
        "plugins": [
          {
            "path": "tools/nfs-esbuild-plugin.mjs",
            "options": {
              "mode": "string",
              "includePaths": [
                "apps/fixture/src/foundation-settings"
              ]
            }
          }
        ]
      }
    },
    "build-file": {
      "executor": "@nx/angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/fixture-file",
        "browser": "apps/fixture/src/main.ts",
        "server": "apps/fixture/src/main.server.ts",
        "tsConfig": "apps/fixture/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/fixture/public"
          }
        ],
        "styles": [
          "apps/fixture/src/lib/scss/global.scss",
          "apps/fixture/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "apps/fixture/src/foundation-settings"
          ],
          "sass": {
            "silenceDeprecations": [
              "import",
              "global-builtin",
              "color-functions",
              "slash-div",
              "if-function"
            ]
          }
        },
        "outputMode": "server",
        "ssr": {
          "entry": "apps/fixture/src/server.ts"
        },
        "security": {
          "allowedHosts": []
        },
        "budgets": [],
        "outputHashing": "all",
        "fileReplacements": [
          {
            "replace": "apps/fixture/src/lib/switches.ts",
            "with": "apps/fixture/src/lib/switches.file.ts"
          },
          {
            "replace": "apps/fixture/src/lib/css/button.ts",
            "with": "apps/fixture/src/lib/css/button.plugin.ts"
          },
          {
            "replace": "apps/fixture/src/lib/css/callout.ts",
            "with": "apps/fixture/src/lib/css/callout.plugin.ts"
          },
          {
            "replace": "apps/fixture/src/lib/css/menu.ts",
            "with": "apps/fixture/src/lib/css/menu.plugin.ts"
          },
          {
            "replace": "apps/fixture/src/lib/css/dropdown-menu.ts",
            "with": "apps/fixture/src/lib/css/dropdown-menu.plugin.ts"
          }
        ],
        "plugins": [
          {
            "path": "tools/nfs-esbuild-plugin.mjs",
            "options": {
              "mode": "file",
              "includePaths": [
                "apps/fixture/src/foundation-settings"
              ]
            }
          }
        ]
      },
      "configurations": {
        "production": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-file"
        },
        "subpath": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-file-subpath",
          "baseHref": "/sub/"
        },
        "cdn": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-file-cdn",
          "deployUrl": "http://127.0.0.1:4795/cdn/"
        },
        "i18n": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-file-i18n",
          "localize": true
        },
        "prefix": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-file-prefix",
          "fileReplacements": [
            {
              "replace": "apps/fixture/src/lib/switches.ts",
              "with": "apps/fixture/src/lib/switches.file-prefix.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/button.ts",
              "with": "apps/fixture/src/lib/css/button.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/callout.ts",
              "with": "apps/fixture/src/lib/css/callout.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/menu.ts",
              "with": "apps/fixture/src/lib/css/menu.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/dropdown-menu.ts",
              "with": "apps/fixture/src/lib/css/dropdown-menu.plugin.ts"
            }
          ]
        },
        "subpath-prefix": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-file-subpath-prefix",
          "baseHref": "/sub/",
          "fileReplacements": [
            {
              "replace": "apps/fixture/src/lib/switches.ts",
              "with": "apps/fixture/src/lib/switches.file-prefix.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/button.ts",
              "with": "apps/fixture/src/lib/css/button.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/callout.ts",
              "with": "apps/fixture/src/lib/css/callout.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/menu.ts",
              "with": "apps/fixture/src/lib/css/menu.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/dropdown-menu.ts",
              "with": "apps/fixture/src/lib/css/dropdown-menu.plugin.ts"
            }
          ]
        },
        "cdn-prefix": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-file-cdn-prefix",
          "deployUrl": "http://127.0.0.1:4803/cdn/",
          "fileReplacements": [
            {
              "replace": "apps/fixture/src/lib/switches.ts",
              "with": "apps/fixture/src/lib/switches.file-prefix.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/button.ts",
              "with": "apps/fixture/src/lib/css/button.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/callout.ts",
              "with": "apps/fixture/src/lib/css/callout.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/menu.ts",
              "with": "apps/fixture/src/lib/css/menu.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/dropdown-menu.ts",
              "with": "apps/fixture/src/lib/css/dropdown-menu.plugin.ts"
            }
          ]
        },
        "i18n-prefix": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-file-i18n-prefix",
          "localize": true,
          "fileReplacements": [
            {
              "replace": "apps/fixture/src/lib/switches.ts",
              "with": "apps/fixture/src/lib/switches.file-prefix.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/button.ts",
              "with": "apps/fixture/src/lib/css/button.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/callout.ts",
              "with": "apps/fixture/src/lib/css/callout.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/menu.ts",
              "with": "apps/fixture/src/lib/css/menu.plugin.ts"
            },
            {
              "replace": "apps/fixture/src/lib/css/dropdown-menu.ts",
              "with": "apps/fixture/src/lib/css/dropdown-menu.plugin.ts"
            }
          ]
        },
        "cachebust": {
          "budgets": [],
          "outputHashing": "all",
          "outputPath": "dist/apps/fixture-file-cachebust",
          "stylePreprocessorOptions": {
            "includePaths": [
              "apps/fixture/src/foundation-settings-cachebust",
              "apps/fixture/src/foundation-settings"
            ],
            "sass": {
              "silenceDeprecations": [
                "import",
                "global-builtin",
                "color-functions",
                "slash-div",
                "if-function"
              ]
            }
          },
          "plugins": [
            {
              "path": "tools/nfs-esbuild-plugin.mjs",
              "options": {
                "mode": "file",
                "includePaths": [
                  "apps/fixture/src/foundation-settings-cachebust",
                  "apps/fixture/src/foundation-settings"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
