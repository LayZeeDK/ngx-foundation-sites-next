{
  "name": "shop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/shop/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/shop",
        "browser": "apps/shop/src/main.ts",
        "tsConfig": "apps/shop/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/shop/public"
          }
        ],
        "styles": ["apps/shop/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["node_modules/foundation-sites/scss"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "syncGenerators": ["...", "ngx-foundation-sites:variant-types-sync"]
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "shop:build:production"
        },
        "development": {
          "buildTarget": "shop:build:development"
        }
      },
      "syncGenerators": ["...", "ngx-foundation-sites:variant-types-sync"]
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      },
      "syncGenerators": ["...", "ngx-foundation-sites:variant-types-sync"]
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "shop:build",
        "staticFilePath": "dist/apps/shop/browser",
        "spa": true
      }
    },
    "nfs-variants": {
      "executor": "ngx-foundation-sites:variant-types",
      "cache": false,
      "options": {
        "buildTarget": "shop:build"
      },
      "configurations": {
        "check": {
          "check": true
        }
      }
    }
  }
}
