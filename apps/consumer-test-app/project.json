{
  "name": "consumer-test-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/consumer-test-app/src",
  "tags": ["scope:e2e", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/consumer-test-app",
        "browser": "apps/consumer-test-app/src/main.ts",
        "tsConfig": "apps/consumer-test-app/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/consumer-test-app/public"
          }
        ],
        "styles": [
          "apps/consumer-test-app/src/styles.scss",
          {
            "input": "dist/packages/ngx-foundation-sites/scss/accordion.scss",
            "bundleName": "nfs-accordion",
            "inject": false
          },
          {
            "input": "dist/packages/ngx-foundation-sites/scss/button.scss",
            "bundleName": "nfs-button",
            "inject": false
          }
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "apps/consumer-test-app/src/styles",
            "dist/packages/ngx-foundation-sites/scss/defaults",
            "dist/packages/ngx-foundation-sites/scss",
            "node_modules"
          ]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "rtl": {
          "index": "apps/consumer-test-app/src/index-rtl.html",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "stylePreprocessorOptions": {
            "includePaths": [
              "apps/consumer-test-app/src/styles-rtl",
              "apps/consumer-test-app/src/styles",
              "dist/packages/ngx-foundation-sites/scss/defaults",
              "dist/packages/ngx-foundation-sites/scss",
              "node_modules"
            ]
          }
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "consumer-test-app:build:production"
        },
        "development": {
          "buildTarget": "consumer-test-app:build:development"
        },
        "rtl": {
          "buildTarget": "consumer-test-app:build:rtl"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "consumer-test-app:build",
        "port": 4200,
        "staticFilePath": "dist/apps/consumer-test-app/browser",
        "spa": true
      }
    }
  }
}
