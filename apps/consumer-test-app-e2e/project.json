{
  "name": "consumer-test-app-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/consumer-test-app-e2e/src",
  "implicitDependencies": ["consumer-test-app"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/consumer-test-app-e2e"
      ],
      "options": {
        "config": "apps/consumer-test-app-e2e/playwright.config.ts",
        "project": ["chromium"]
      }
    },
    "e2e-rtl": {
      "executor": "@nx/playwright:playwright",
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/consumer-test-app-e2e-rtl"
      ],
      "options": {
        "config": "apps/consumer-test-app-e2e/playwright-rtl.config.ts",
        "project": ["chromium"]
      }
    }
  }
}
