{
  "name": "ngx-foundation-sites",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ngx-foundation-sites/src",
  "prefix": "nfs",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "generators": {
    "@nx/angular:component": {
      "viewEncapsulation": "None"
    }
  },
  "targets": {
    "bundle-sass": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/tools/bundle-sass-sources.mjs",
        "{projectRoot}/src/lib/scss/**/*.scss",
        "{workspaceRoot}/node_modules/foundation-sites/scss/**/*.scss"
      ],
      "outputs": ["{projectRoot}/src/storybook/generated/sass-bundle.ts"],
      "cache": true,
      "options": {
        "command": "node packages/ngx-foundation-sites/tools/bundle-sass-sources.mjs"
      }
    },
    "build-css": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/tools/build-component-css.mjs",
        "{projectRoot}/src/lib/scss/**/*.scss",
        "{workspaceRoot}/node_modules/foundation-sites/scss/**/*.scss"
      ],
      "outputs": ["{projectRoot}/dist-css"],
      "cache": true,
      "options": {
        "command": "node packages/ngx-foundation-sites/tools/build-component-css.mjs"
      }
    },
    "bundle-sass-compiler": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/tools/bundle-sass-compiler.mjs",
        "{workspaceRoot}/node_modules/sass/**/*"
      ],
      "outputs": ["{projectRoot}/.storybook/static/sass-browser.mjs"],
      "cache": true,
      "options": {
        "command": "node packages/ngx-foundation-sites/tools/bundle-sass-compiler.mjs"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "dependsOn": ["build-css"],
      "options": {
        "project": "packages/ngx-foundation-sites/ng-package.json",
        "tsConfig": "packages/ngx-foundation-sites/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ngx-foundation-sites/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "browsers": ["chromium"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "dependsOn": ["build-css", "bundle-sass", "bundle-sass-compiler"],
      "inputs": [
        "default",
        "{projectRoot}/.compodocrc.json",
        "{projectRoot}/.storybook/**/*"
      ],
      "options": {
        "port": 4400,
        "open": false,
        "configDir": "packages/ngx-foundation-sites/.storybook",
        "browserTarget": "ngx-foundation-sites:build-storybook",
        "compodoc": true,
        "compodocArgs": [
          "-c",
          "packages/ngx-foundation-sites/.compodocrc.json"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "packages/ngx-foundation-sites/src/storybook",
            "node_modules",
            "node_modules/foundation-sites/scss"
          ]
        },
        "styles": ["packages/ngx-foundation-sites/src/storybook/styles.scss"],
        "experimentalZoneless": true
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "pre-build-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx rimraf dist/storybook/ngx-foundation-sites"
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "dependsOn": [
        "pre-build-storybook",
        "build-css",
        "bundle-sass",
        "bundle-sass-compiler"
      ],
      "inputs": [
        "default",
        "{projectRoot}/.compodocrc.json",
        "{projectRoot}/.storybook/**/*"
      ],
      "outputs": ["{options.outputDir}", "{projectRoot}/documentation.json"],
      "options": {
        "outputDir": "dist/storybook/ngx-foundation-sites",
        "configDir": "packages/ngx-foundation-sites/.storybook",
        "browserTarget": "ngx-foundation-sites:build-storybook",
        "compodoc": true,
        "compodocArgs": [
          "-c",
          "packages/ngx-foundation-sites/.compodocrc.json"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "packages/ngx-foundation-sites/src/storybook",
            "node_modules",
            "node_modules/foundation-sites/scss"
          ]
        },
        "styles": ["packages/ngx-foundation-sites/src/storybook/styles.scss"],
        "experimentalZoneless": true
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx wait-on http://localhost:4400 && npx test-storybook -c packages/ngx-foundation-sites/.storybook --url=http://localhost:4400"
      },
      "dependsOn": [
        {
          "target": "storybook",
          "params": "forward"
        }
      ]
    },
    "test-static-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx wait-on http://localhost:4400 && npx test-storybook -c packages/ngx-foundation-sites/.storybook --url=http://localhost:4400"
      },
      "dependsOn": [
        {
          "target": "static-storybook",
          "params": "forward"
        }
      ]
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "continuous": true,
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "ngx-foundation-sites:build-storybook",
        "staticFilePath": "dist/storybook/ngx-foundation-sites",
        "port": 4400,
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "ngx-foundation-sites:build-storybook:ci"
        }
      }
    }
  }
}
