{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx"
  },
  "exclude": ["../**/*.spec.ts"],
  "include": [
    "../src/**/*.stories.ts",
    "../src/**/*.stories.js",
    "../src/**/*.stories.jsx",
    "../src/**/*.stories.tsx",
    "../src/**/*.stories.mdx",
    "../src/storybook/**/*.ts",
    "../documentation.json",
    "../.compodocrc.json",
    "addons/**/*.ts",
    "addons/**/*.tsx",
    "*.js",
    "*.ts"
  ]
}
